
CREATE TABLE Country ( country_id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE );

CREATE TABLE Category ( category_id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE );

CREATE TABLE Museum ( museum_id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, address TEXT, founded_year INTEGER );

CREATE TABLE Branch ( branch_id INTEGER PRIMARY KEY AUTOINCREMENT, museum_id INTEGER NOT NULL, name TEXT NOT NULL, address TEXT, FOREIGN KEY (museum_id) REFERENCES Museum(museum_id) );

CREATE TABLE Exhibit ( exhibit_id INTEGER PRIMARY KEY AUTOINCREMENT, branch_id INTEGER NOT NULL, category_id INTEGER NOT NULL, country_id INTEGER, inventory_number TEXT UNIQUE, name TEXT NOT NULL, description TEXT, creation_year TEXT, FOREIGN KEY (branch_id) REFERENCES Branch(branch_id), FOREIGN KEY (category_id) REFERENCES Category(category_id), FOREIGN KEY (country_id) REFERENCES Country(country_id) );

